<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kobestarr.reply-engine</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kobestarr/Development/One Hour Vibe Coder/outreach-automation/reply-engine.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/kobestarr/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>OA_DATA_DIR</key>
        <string>/Users/kobestarr/Development/One Hour Vibe Coder/outreach-automation/data</string>
    </dict>
    <!-- Every 5 minutes -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/kobestarr/.config/dev-autosave/logs/reply-engine.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kobestarr/.config/dev-autosave/logs/reply-engine.err.log</string>
</dict>
</plist>
